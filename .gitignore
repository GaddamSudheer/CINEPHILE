
# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Environment variables and secrets
.env
.env.*
!.env.example

# Frontend
node_modules/
dist/
build/
coverage/

# IDE and operating system
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db

# Data files - keep originals outside Git
data/raw/*
data/processed/*
data/curated/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/curated/.gitkeep

# Logs and temporary files
*.log
tmp/
temp/

# Jupyter
.ipynb_checkpoints/

# Local databases and backups
*.sqlite
*.db
*.dump
*.bak
